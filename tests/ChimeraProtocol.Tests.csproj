<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <!--
    Logique pure (sans dépendance moteur) testée directement, en la liant à l'assembly de test.
    Elle vit désormais sous unity/Assets/ (docs/UNITY_MIGRATION_PLAN.md §3.2) : un seul
    exemplaire, compilé par chemin par Godot, par Unity et par ces tests. Ces tests valident
    donc les DEUX moteurs.
  -->
  <ItemGroup>
    <Compile Include="..\unity\Assets\Scripts\Shared\Rules\*.cs" />
    <!--
      Socle du port Unity (Pcg32…) : pur lui aussi, donc couvert par cette même suite. Sous Unity
      il vit dans l'assembly ChimeraProtocol.PlatformCore, également en noEngineReferences.
    -->
    <Compile Include="..\unity\Assets\Scripts\Shared\PlatformCore\*.cs" />
  </ItemGroup>

</Project>
